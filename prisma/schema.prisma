datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String?           @unique
  password         String?
  role             String            @default("PATIENT") // PATIENT, ADMIN, CLINICIAN
  savedDiseases    SavedDisease[]
  savedResearch    SavedResearch[]
  savedSpecialists SavedSpecialist[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Disease {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  category          String         // e.g. Neurological, Metabolic, Genetic, Immunological
  overview          String         @db.Text
  simpleDescription String         @db.Text
  medicalDescription String        @db.Text
  causes            String         @db.Text
  symptoms          String         @db.Text
  types             String         @db.Text
  diagnosis         String         @db.Text
  treatments        String         @db.Text
  images            String?        @db.Text // Comma-separated URLs
  references        String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  clinicalTrials    ClinicalTrial[]
  researchUpdates   Research[]
  specialists       Specialist[]
  communities       Community[]
  faqs              FAQ[]
  savedBy           SavedDisease[]
}

model ClinicalTrial {
  id             String   @id @default(cuid())
  name           String
  identifier     String   @unique // e.g. NCT05891322
  organization   String
  phase          String   // Phase 1, Phase 2, Phase 3, Phase 4, etc.
  status         String   // Recruiting, Active, Completed, Terminated
  description    String   @db.Text
  latestFindings String?  @db.Text
  officialLink   String
  diseaseId      String
  disease        Disease  @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Specialist {
  id             String            @id @default(cuid())
  name           String
  profession     String            // e.g. Neurologist, Geneticist, Cardiologist
  specialization String            // e.g. Neurodegenerative Disorders
  organization   String
  location       String
  email          String?
  phone          String?
  website        String?
  publications   String?           @db.Text // JSON or list format
  image          String?           @db.Text
  diseaseId      String
  disease        Disease           @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  savedBy        SavedSpecialist[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Community {
  id          String   @id @default(cuid())
  name        String
  website     String?
  facebook    String?
  description String   @db.Text
  country     String
  diseaseId   String
  disease     Disease  @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Research {
  id               String          @id @default(cuid())
  title            String
  summary          String          @db.Text // Family-friendly summary
  scientificDetail String          @db.Text // Heavy research abstract
  publishedAt      DateTime?
  journal          String?
  author           String?
  link             String?
  diseaseId        String
  disease          Disease         @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  savedBy          SavedResearch[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  diseaseId String
  disease   Disease  @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedDisease {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  diseaseId String
  disease   Disease  @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, diseaseId])
}

model SavedResearch {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  researchId String
  research   Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, researchId])
}

model SavedSpecialist {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, specialistId])
}
